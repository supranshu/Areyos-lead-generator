AREYOS_DATABASE_URL=postgresql+psycopg://areyos:areyos@localhost:5432/areyos

# Google Places API (New): enable "Places API (New)" in Google Cloud and create a key.
AREYOS_GOOGLE_PLACES_API_KEY=
# The city viewport is split into GRID x GRID tiles; each tile runs every industry query (max 60 results each).
AREYOS_GOOGLE_GRID_SIZE=2
AREYOS_GOOGLE_MAX_PAGES=3
# Website/phone/rating fields cost more per request; false keeps only basic fields.
AREYOS_GOOGLE_CONTACT_FIELDS=true

AREYOS_OSM_ENABLED=true
# Use a URL people can reach you at; the Overpass and Nominatim policies ask for it.
AREYOS_USER_AGENT=AreyosLeadBot/1.0 (+https://areyos.com)
AREYOS_PER_HOST_DELAY=1.0

AREYOS_ENRICH_ENABLED=true
AREYOS_ENRICH_MAX_PAGES=3
AREYOS_ENRICH_REFRESH_DAYS=30

# Decision-maker identification
AREYOS_PEOPLE_ENABLED=true
AREYOS_PEOPLE_MIN_PRIORITY=medium
AREYOS_PEOPLE_MIN_CONFIDENCE=0.6
AREYOS_PEOPLE_MAX_PAGES=5
# Search API for public LinkedIn profile results: brave | google_cse (leave empty to use websites only)
AREYOS_PEOPLE_SEARCH_PROVIDER=
AREYOS_PEOPLE_MAX_SEARCH_QUERIES=2
AREYOS_BRAVE_API_KEY=
AREYOS_GOOGLE_CSE_KEY=
AREYOS_GOOGLE_CSE_CX=
# Optional: Hunter.io domain search (only emails Hunter found on public pages are kept)
AREYOS_HUNTER_API_KEY=

# Opportunity scoring and reports. Claude is used when Anthropic credentials are available
# (ANTHROPIC_API_KEY, or an `ant auth login` profile); otherwise everything is rules-based.
AREYOS_OPPORTUNITY_ENABLED=true
AREYOS_OPPORTUNITY_AI=true
AREYOS_OPPORTUNITY_MODEL=claude-opus-5-5
AREYOS_OPPORTUNITY_EFFORT=medium
AREYOS_OPPORTUNITY_MAX_PAGES=6
# Claude reads evidence only for prospects at or above this priority; others get free rules-based scores and reports.
AREYOS_OPPORTUNITY_MIN_PRIORITY=medium
ANTHROPIC_API_KEY=
